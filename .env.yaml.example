
# .env.yaml.example
# This file is a template for setting environment variables on a Google Cloud Run service.
# Rename this file to '.env.yaml.production' and fill in your values.
# Deploy these variables using the update-service.sh script or by running:
# gcloud run services update SERVICE_NAME --update-env-vars-from-file .env.yaml.production

# Example:
# API_KEY: "your_api_key_for_server_side_logic_if_any"
# ANOTHER_VAR: "another_value"
